# PostgreSQL接続設定の例

#

# このファイルを実設定として直接使用しないでください。

#

# 利用者環境では、次のようなGit管理外の場所へコピーして使用します。

#

# ~/.config/marimo/db.env

#

# コピー後は、所有者だけが読み書きできるように権限を設定してください。

#

# chmod 600 ~/.config/marimo/db.env

#

# このファイルや実際の認証情報をGitへ登録しないでください。

# PostgreSQLサーバーのホスト名またはIPアドレス

BENCHMARK_DB_HOST=""

# PostgreSQLのポート番号

BENCHMARK_DB_PORT="5432"

# 接続先データベース名

BENCHMARK_DB_NAME=""

# PostgreSQLのユーザー名

BENCHMARK_DB_USER=""

# PostgreSQLのパスワード

BENCHMARK_DB_PASSWORD=""

# SSL接続モード

#

# PostgreSQLおよびpsycopgで一般的に利用される値:

#

# disable

# allow

# prefer

# require

# verify-ca

# verify-full

#

# 社内のPostgreSQL接続要件に従って設定してください。

BENCHMARK_DB_SSLMODE="prefer"

# 接続タイムアウト秒数

BENCHMARK_DB_CONNECT_TIMEOUT="10"

# アプリケーション名

#

# PostgreSQLのpg_stat_activity等で接続元を識別するために使用します。

BENCHMARK_DB_APPLICATION_NAME="marimo-analysis"

# 任意: PostgreSQL接続時の検索パス

#

# 使用しない場合は空欄のままにしてください。

BENCHMARK_DB_SEARCH_PATH=""

# 任意: SSLルート証明書

#

# verify-caまたはverify-fullを使用する場合に指定します。

# コンテナから参照できるパスを設定してください。

BENCHMARK_DB_SSLROOTCERT=""

# 任意: SSLクライアント証明書

BENCHMARK_DB_SSLCERT=""

# 任意: SSLクライアント秘密鍵

BENCHMARK_DB_SSLKEY=""

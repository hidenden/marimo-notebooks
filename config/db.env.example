# PostgreSQL接続設定の例

#

# このファイルを実設定として直接使用しないでください。

#

# 各利用者が踏み台サーバー上の次の場所へコピーします。

#

# ${XDG_CONFIG_HOME:-$HOME/.config}/marimo-notebooks/db.env

#

# コピーした利用者だけが読み書きできるように権限を設定してください。

#

# chmod 700 "${XDG_CONFIG_HOME:-$HOME/.config}/marimo-notebooks"
# chmod 600 "${XDG_CONFIG_HOME:-$HOME/.config}/marimo-notebooks/db.env"

#

# このファイルや実際の認証情報をGitへ登録しないでください。

# PostgreSQLサーバーのホスト名またはIPアドレス

BENCHMARK_DB_HOST=db.example.internal

# PostgreSQLのポート番号

BENCHMARK_DB_PORT=5432

# 接続先データベース名

BENCHMARK_DB_NAME=benchmark

# PostgreSQLのユーザー名

BENCHMARK_DB_USER=benchmark_reader

# PostgreSQLのパスワード

BENCHMARK_DB_PASSWORD=replace-with-shared-read-only-password

# SSL接続モード

#

# PostgreSQLおよびpsycopgで一般的に利用される値:

#

# disable

# allow

# prefer

# require

# verify-ca

# verify-full

#

# 社内のPostgreSQL接続要件に従って設定してください。

BENCHMARK_DB_SSLMODE=prefer

# 接続タイムアウト秒数

BENCHMARK_DB_CONNECT_TIMEOUT=10

# アプリケーション名

#

# PostgreSQLのpg_stat_activity等で接続元を識別するために使用します。

BENCHMARK_DB_APPLICATION_NAME=marimo-analysis
